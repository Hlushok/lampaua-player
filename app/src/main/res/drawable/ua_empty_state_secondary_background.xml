<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ua_blue" />
            <stroke android:width="3dp" android:color="@color/ua_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF123B70" />
            <stroke android:width="2dp" android:color="@color/ua_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3051830" />
            <stroke android:width="1dp" android:color="#FF365B82" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
