<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ua_empty_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ua_empty_state_background"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:padding="32dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:contentDescription="@null"
                android:src="@drawable/ua_player_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/ua_gold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FF087AE5" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/empty_state_subtitle"
                android:textColor="@color/ua_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="220dp"
            android:layout_marginStart="38dp"
            android:layout_marginEnd="38dp"
            android:background="#66F0B726" />

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ua_empty_state_open"
                style="@style/UaEmptyStateAction.Primary"
                android:drawableStart="@drawable/ic_folder_open_24dp"
                android:text="@string/empty_state_open" />

            <TextView
                android:id="@+id/ua_empty_state_link"
                style="@style/UaEmptyStateAction.Secondary"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_link_24dp"
                android:text="@string/empty_state_link" />

            <TextView
                android:id="@+id/ua_empty_state_together"
                style="@style/UaEmptyStateAction.Secondary"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_together_24dp"
                android:text="@string/empty_state_together" />

            <TextView
                android:id="@+id/ua_empty_state_settings"
                style="@style/UaEmptyStateAction.Secondary"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_settings_24dp"
                android:text="@string/button_app_settings" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
