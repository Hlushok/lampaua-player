<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ua_navy"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/report_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/report_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ua_secondary"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/ua_report_panel_background"
        android:fillViewport="true"
        android:focusable="true">

        <TextView
            android:id="@+id/report_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/white"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/report_copy"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/ua_tv_control_background"
            android:focusable="true"
            android:minWidth="96dp"
            android:text="@string/playback_report_copy"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/report_share"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ua_tv_control_background"
            android:focusable="true"
            android:minWidth="96dp"
            android:text="@string/playback_report_share"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/report_close"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ua_tv_control_background"
            android:focusable="true"
            android:minWidth="96dp"
            android:text="@string/playback_report_close"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
