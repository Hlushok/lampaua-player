<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ua_empty_state"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ua_empty_state_background"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:padding="20dp"
    android:visibility="gone">

    <!-- Donor-style responsive lockup: identity stays out of the action column. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ua_player_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_state_subtitle"
            android:textColor="@color/ua_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ua_empty_state_open"
            style="@style/UaEmptyStateAction.Primary"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_folder_open_24dp"
            android:text="@string/empty_state_open" />

        <TextView
            android:id="@+id/ua_empty_state_link"
            style="@style/UaEmptyStateAction.Secondary"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_link_24dp"
            android:text="@string/empty_state_link" />

        <TextView
            android:id="@+id/ua_empty_state_together"
            style="@style/UaEmptyStateAction.Secondary"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_together_24dp"
            android:text="@string/empty_state_together" />

        <TextView
            android:id="@+id/ua_empty_state_settings"
            style="@style/UaEmptyStateAction.Secondary"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_settings_24dp"
            android:text="@string/button_app_settings" />
    </LinearLayout>

</FrameLayout>
