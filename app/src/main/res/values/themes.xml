<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/ui_controls_background</item>
        <item name="android:navigationBarColor">@color/ui_controls_background</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="colorAccent">@color/ua_gold</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/ua_gold</item>
        <item name="colorControlHighlight">@color/ua_blue</item>
        <item name="android:colorAccent">@color/ua_gold</item>
        <item name="android:colorControlNormal">@color/white</item>
        <item name="android:colorControlActivated">@color/ua_gold</item>
        <item name="android:colorControlHighlight">@color/ua_blue</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Player.Dialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Player.Dialog</item>
    </style>

    <style name="Theme.Player" parent="BaseTheme.Player">
    </style>

    <style name="Theme.Player.Settings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ua_navy</item>
        <item name="android:statusBarColor">@color/ua_navy</item>
        <item name="android:navigationBarColor">@color/ua_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/ua_secondary</item>
        <item name="colorAccent">@color/ua_gold</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/ua_gold</item>
        <item name="colorControlHighlight">@color/ua_blue</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Player.Dialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Player.Dialog</item>
    </style>

    <style name="ThemeOverlay.Player.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/ua_dialog_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/ua_secondary</item>
        <item name="colorAccent">@color/ua_gold</item>
        <item name="android:colorAccent">@color/ua_gold</item>
    </style>

    <style name="ExoStyledControls.Button.Center.Secondary" parent="ExoStyledControls.Button.Center">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Transparent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="MediaStoreChooserDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item> <!-- When focused, line scrolls -->
    </style>
</resources>
